{
  "Urls": "http://localhost:5000",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "login": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/auth/login", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "me": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/me", "Methods": [ "GET" ] },
        "Transforms": [ { "PathPattern": "/users/me" } ]
      },
      "courses": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/courses", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "course": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/courses/{courseId:int}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "students": {
        "ClusterId": "sync",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/courses/{courseId:int}/students/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "grades": {
        "ClusterId": "sync",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/courses/{courseId:int}/grades/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "sync": {
        "ClusterId": "sync",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/courses/{courseId:int}/sync/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "analytics": {
        "ClusterId": "analytics",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/courses/{courseId:int}/analytics/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "sync": { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } },
      "analytics": { "Destinations": { "d1": { "Address": "http://localhost:5003/" } } }
    }
  }
}
