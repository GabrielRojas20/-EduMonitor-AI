# Variables del agent-service (todas son opcionales: estos son los valores por defecto)
OLLAMA_URL=http://localhost:11434
AGENT_MODEL=qwen3:1.7b
# Dirección del gateway real, o del mock (mocks/gateway-mock) mientras tanto
GATEWAY_URL=http://localhost:5000
OLLAMA_KEEP_ALIVE=10m
MAX_TOOL_CALLS=5
TOOL_TIMEOUT_SECONDS=10
MESSAGE_TIMEOUT_SECONDS=60
# Orígenes del navegador que pueden llamar al agente (la interfaz React)
AGENT_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
