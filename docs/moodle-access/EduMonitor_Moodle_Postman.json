      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/webservice/rest/server.php?wstoken={{token}}&wsfunction=core_webservice_get_site_info&moodlewsrestformat=json",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "webservice",
            "rest",
            "server.php"
          ],
          "query": [
            {
              "key": "wstoken",
              "value": "{{token}}"
            },
            {
              "key": "wsfunction",
              "value": "core_webservice_get_site_info"
            },
            {
              "key": "moodlewsrestformat",
              "value": "json"
            }
          ]
        }
