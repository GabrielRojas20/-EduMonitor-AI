# Copiar a .env y completar. NUNCA subir .env al repositorio.

# SQL Server (usa la misma clave en MSSQL_SA_PASSWORD y en las cadenas de conexión)
MSSQL_SA_PASSWORD=tu-clave-sql-local
MSSQL_HOST=sqlserver
MSSQL_PORT=1433

# Moodle
MOODLE_BASE_URL=http://localhost:8080
MOODLE_WS_TOKEN=
MOODLE_WS_SERVICE=
MOODLE_DB_PASSWORD=moodle_dev_password
MOODLE_DB_ROOT_PASSWORD=root_dev_password
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=tu-clave-admin-local
MOODLE_ADMIN_EMAIL=admin@example.test

# Servicios
GATEWAY_URL=http://localhost:5000
ANALYTICS_URL=http://localhost:5003
AGENT_URL=http://localhost:5004

# Ollama (agent-service; estos son los nombres que lee el código actual)
OLLAMA_URL=http://localhost:11434
AGENT_MODEL=qwen3:1.7b

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth Service & JWT
JWT_SECRET=tu-clave-secreta-de-al-menos-32-caracteres
JWT_ISSUER=edumonitor
JWT_AUDIENCE=edumonitor-api
JWT_EXPIRES_MINUTES=60
AUTH_SEED_PASSWORD=tu-clave-de-prueba-local

# Dataset de Auth y Moodle. Usa massive para la demo de Sprint 3.
AUTH_SEED_DATASET=minimal
DEMO_DATASET=minimal

# Estas cadenas se usan si se ejecuta un servicio fuera de Docker; deben coincidir
# con MSSQL_SA_PASSWORD. Docker Compose las construye/sobrescribe para sus contenedores.
ConnectionStrings__Auth="Server=sqlserver,1433;Database=EduMonitorAuth;User Id=sa;Password=tu-clave-sql-local;TrustServerCertificate=True;"
ConnectionStrings__EduMonitor="Server=sqlserver,1433;Database=EduMonitor;User Id=sa;Password=tu-clave-sql-local;TrustServerCertificate=True;"
